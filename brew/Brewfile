# Everything the dotfiles need on macOS. install.sh runs:
#   brew bundle --file=~/dotfiles/brew/Brewfile
# (brew/Brewfile.all is a snapshot of everything installed on the main Mac)

# Core
brew "git"
brew "neovim"
brew "starship"
brew "chezmoi"          # puts the configs in place (home/ in the repo)
brew "mise"             # Node, Go and other runtimes (~/.config/mise/config.toml)
brew "tree-sitter-cli"  # builds Neovim's Treesitter parsers
brew "ripgrep"

# Shell
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "fzf"
brew "eza"
brew "bat"
brew "git-delta"
brew "zoxide"

# Apps and fonts. WezTerm isn't here: this setup uses the patched build from
# ~/developer/wezterm (see FORK.md there; scripts/build-macos-app.sh). Stock
# WezTerm (`brew install --cask wezterm`) also works with the config, it just
# skips the patched-only options
cask "font-jetbrains-mono"
