# No duplicate PATH entries, however many shells nest
typeset -U path PATH

# History: large, shared live between tabs, no duplicates
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks

# Completion: Homebrew's completions on macOS, and a cached compinit that only
# rebuilds its dump once a day (an uncached compinit costs ~50ms per shell)
typeset -U fpath
if [[ "$OSTYPE" == "darwin"* ]]; then
  fpath=("${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit
() {
  setopt local_options extended_glob
  local dump="${ZDOTDIR:-$HOME}/.zcompdump"
  if [[ -f "$dump" && -z $dump(#qN.mh+24) ]]; then
    compinit -C -d "$dump"
  else
    compinit -d "$dump"
  fi
}

# Load all zsh config files (mise, Bun, Java and PATH live in exports.zsh)
source ~/.config/zsh/exports.zsh
source ~/.config/zsh/aliases.zsh
source ~/.config/zsh/tools.zsh   # before plugins, so syntax highlighting sees fzf's widgets
source ~/.config/zsh/plugins.zsh

# Starship prompt
eval "$(starship init zsh)"

# Transient prompt: once a command runs, its prompt collapses to "❯ command"
# so scrollback stays clean and only the live prompt shows the pills.
# Skipped when Kiln draws its own prompt (KILN_PROMPT=kiln): Kiln already shows
# each command as a block, and rewriting the prompt there recolours its ❯
if [[ "$KILN_PROMPT" != kiln ]]; then
zle-line-init() {
  emulate -L zsh
  [[ $CONTEXT == start ]] || return 0

  while true; do
    zle .recursive-edit
    local -i ret=$?
    [[ $ret == 0 && $KEYS == $'\4' ]] || break # Ctrl-D on an empty line
    [[ -o ignore_eof ]] || exit 0
  done

  local saved_prompt=$PROMPT saved_rprompt=$RPROMPT
  PROMPT='%B%F{#e07b39}❯%f%b '
  RPROMPT=''
  zle .reset-prompt
  PROMPT=$saved_prompt
  RPROMPT=$saved_rprompt

  if (( ret )); then
    zle .send-break
  else
    zle .accept-line
  fi
  return ret
}
zle -N zle-line-init
fi

