# Git diffs through delta (https://github.com/dandavison/delta), in the shared
# Gruvbox palette. Included from ~/.gitconfig by install.sh:
#   git config --global include.path ~/dotfiles/git/delta.gitconfig
[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true           # n / N jump between files
	line-numbers = true
	syntax-theme = gruvbox-dark
	file-style = bold "#e07b39"
	file-decoration-style = "#504945" ul
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#504945" box
	line-numbers-left-style = "#665c54"
	line-numbers-right-style = "#665c54"
	line-numbers-minus-style = "#fb4934"
	line-numbers-plus-style = "#b8bb26"
	minus-style = syntax "#3c1f1e"
	minus-emph-style = syntax "#6b2522"
	plus-style = syntax "#32361a"
	plus-emph-style = syntax "#4b5228"

[merge]
	conflictstyle = zdiff3
